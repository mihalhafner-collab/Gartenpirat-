{
  "description": "Gartenpirat: aktuelle Arbeitsregeln und Arbeitsstand vor jeder Eingabe neu lesen.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"$(git rev-parse --show-toplevel)/.codex/read_project_context.py\"",
            "timeout": 10,
            "additionalContextLimit": 20000,
            "statusMessage": "Gartenpirat-Regeln und Arbeitsstand neu lesen"
          }
        ]
      }
    ]
  }
}
