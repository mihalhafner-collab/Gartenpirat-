<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Only the instrumentation APK contains this local, synthetic provider. -->
        <provider
            android:name="at.hausgarten.service.SyntheticBackupDocumentsProvider"
            android:authorities="at.hausgarten.service.test.backupdocs"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS"
            android:process=":qa_documents">
            <!-- Shell can acquire the control endpoint; document paths still require SAF grants. -->
            <path-permission
                android:path="/qa-control"
                android:readPermission="android.permission.DUMP"
                android:writePermission="android.permission.DUMP" />
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>
</manifest>
